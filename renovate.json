{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["headscale/headscale"],
      "matchUpdateTypes": ["minor", "patch", "major"],
      "ignoreUnstable": true,
      "automerge": true
    }
  ]
}